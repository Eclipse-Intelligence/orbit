# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
!.env.example

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

/companion/dist
/extension/dist
/public/downloads

/evals/results/

# agent and workspace tools
/.context/
/.conductor/settings.local.*
.claude/worktrees/
.claude/settings.local.json
.claude/scheduled_tasks.*
.claude/checkpoints/
/sweep-results/
