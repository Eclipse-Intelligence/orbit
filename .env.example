DATABASE_URL=postgres://crm_app:crm_app_dev@127.0.0.1:5432/crm
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/crm
APP_SECRET=replace-with-at-least-16-characters
DEV_USER_EMAIL=founder@example.com
DEV_USER_PASSWORD=replace-with-a-local-password
CRM_AGENT_TOKEN=

# Hosted Supabase Auth. Leave unset to use the local password session.
# Project: Orbit (xuvofoydyewbloybrmas), eu-west-1.
# Use the session pooler. Usernames are role.project_ref. Database name is postgres.
# NEXT_PUBLIC_SUPABASE_URL=https://xuvofoydyewbloybrmas.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# NEXT_PUBLIC_SITE_URL=http://localhost:3000
# In production, the https origin. Teams transcript subscriptions and the Granola webhook use it.
# NEXT_PUBLIC_SITE_URL=https://orbit-mark-ridgeons-projects.vercel.app
# DATABASE_URL=postgres://crm_app.xuvofoydyewbloybrmas:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_ADMIN_URL=postgres://crm_admin.xuvofoydyewbloybrmas:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Microsoft mailbox. Delegated permissions: Mail.Read, Mail.Send, User.Read, offline_access.
# Register the redirect URI on the Entra app, then restart the server.
# When the redirect URI is set, Connect sends you to that host first; be signed in there.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=http://localhost:4173/api/microsoft/callback

# Call summaries through the llmapi.ai gateway (OpenAI-compatible).
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_API_BASE_URL=https://api.llmapi.ai/v1

# Automatic transcripts. Granola personal API key (Business plan); empty turns Granola off.
GRANOLA_API_KEY=
# GRANOLA_API_BASE_URL=https://public-api.granola.ai
# Bearer secret for /api/cron/sync (Vercel cron and the Supabase pg_cron job send it).
CRON_SECRET=
