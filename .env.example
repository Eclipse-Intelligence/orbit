DATABASE_URL=postgres://crm_app:crm_app_dev@127.0.0.1:5432/crm
DATABASE_ADMIN_URL=postgres://postgres:postgres@127.0.0.1:5432/crm
APP_SECRET=replace-with-at-least-16-characters
DEV_USER_EMAIL=founder@example.com
DEV_USER_PASSWORD=replace-with-a-local-password
CRM_AGENT_TOKEN=

# Hosted Supabase Auth. Leave unset to use the local password session.
# Project: Orbit (xuvofoydyewbloybrmas), eu-west-1.
# Use the session pooler. Usernames are role.project_ref. Database name is postgres.
# NEXT_PUBLIC_SUPABASE_URL=https://xuvofoydyewbloybrmas.supabase.co
# NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Orbit's origin (NEXT_PUBLIC_SITE_URL works too). Locally, for example http://localhost:3000. In production, the https origin:
# Teams transcript and mail subscriptions, the Granola and ClickUp webhooks, read statuses, booking links and ClickUp task links use it.
# SITE_URL=https://orbit.geteclipse.co
# DATABASE_URL=postgres://crm_app.xuvofoydyewbloybrmas:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require
# DATABASE_ADMIN_URL=postgres://crm_admin.xuvofoydyewbloybrmas:PASSWORD@aws-0-eu-west-1.pooler.supabase.com:5432/postgres?sslmode=require

# Microsoft mailbox. Delegated permissions: Mail.ReadWrite, Mail.Send, User.Read, Calendars.ReadWrite, offline_access.
# Register the redirect URI on the Entra app, then restart the server.
# When the redirect URI is set, Connect sends you to that host first; be signed in there.
# MICROSOFT_CLIENT_ID=
# MICROSOFT_CLIENT_SECRET=
# MICROSOFT_TENANT=common
# MICROSOFT_REDIRECT_URI=http://localhost:4173/api/microsoft/callback

# The assistant, call summaries, Mail AI, the activity and task pads and workflow AI steps, through the llmapi.ai gateway (OpenAI-compatible).
LLM_API_KEY=
# LLM_MODEL=claude-haiku-5-5
# LLM_API_BASE_URL=https://api.llmapi.ai/v1

# Automatic transcripts. Granola personal API key (Business plan); empty turns Granola off.
GRANOLA_API_KEY=
# GRANOLA_API_BASE_URL=https://public-api.granola.ai
# ClickUp personal API token (ClickUp › Settings › Apps › API Token); empty turns ClickUp off.
CLICKUP_API_TOKEN=
# CLICKUP_API_BASE_URL=https://api.clickup.com/api/v2
# Bearer secret for /api/cron/sync, /api/cron/workflows, /api/cron/mail, /api/cron/mail-due and /api/assistant/probe (Vercel cron and the Supabase pg_cron jobs send it).
CRON_SECRET=

# Mail mirror. Database size in MB at which the mail backfill pauses (default 400), and at which all mail sync stops (default 18% above the first).
# MAIL_STORAGE_LIMIT_MB=400
# MAIL_HARD_STOP_MB=472

# Contact and company enrichment. Each key turns its provider on; order is set in Settings › Integrations.
# CONTEXT_DEV_API_KEY=
# HUNTER_API_KEY=
# ENROW_API_KEY=
# ICYPEAS_API_KEY=
# Logo Link public client id from context.dev, for company logos (served by context.dev, never stored).
# NEXT_PUBLIC_CONTEXT_LOGO_CLIENT_ID=

# Linear (personal API key from Linear › Settings › Security and access). Empty turns Linear off.
# LINEAR_API_KEY=
# LINEAR_TEAM_KEY=CNT
# LINEAR_API_URL=https://api.linear.app/graphql

# Supabase secret (service role) key, server only (SUPABASE_SECRET_KEY works too). Lets invites create confirmed logins and stores email attachments.
# SUPABASE_SERVICE_ROLE_KEY=

# Optional. Overrides the time zone for dates and due times (default Europe/London).
# NEXT_PUBLIC_TIMEZONE=Europe/London
